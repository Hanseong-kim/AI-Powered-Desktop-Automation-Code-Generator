<html>
<head>
  <title>Medflow Clinical System</title>

  <!-- HTA configuration (Windows 2003 / mshta.exe) -->
  <HTA:APPLICATION
      ID="MedflowMainApp"
      APPLICATIONNAME="Medflow Clinical System"
      BORDER="thin"
      BORDERSTYLE="normal"
      CAPTION="yes"
      CONTEXTMENU="yes"
      MAXIMIZEBUTTON="yes"
      MINIMIZEBUTTON="yes"
      SHOWINTASKBAR="yes"
      SINGLEINSTANCE="no"
      SYSMENU="yes"
      WINDOWSTATE="maximize"
      SCROLL="no"
  />
  <script src="shared/data.js" language="JScript"></script>

  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <!-- Force old-IE modes (helps on some locked-down machines) -->
  <meta http-equiv="X-UA-Compatible" content="IE=7" />

  <style type="text/css">
    /* ===== Windows 2003 / IE6-friendly styling (no CSS grid/flex/variables) ===== */
    html, body {
      height: 100%;
    }
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #bfbfbf;
      font-family: Tahoma, Arial, sans-serif;
      font-size: 12px;
      color: #111;
      position: relative;
    }

    /* Title bar (internal) */
    .titlebar {
      height: 28px;
      background: #e6e6e6;
      border-bottom: 1px solid #9a9a9a;
      padding: 4px 10px;
      font-weight: bold;
      font-size: 13px;
      line-height: 20px;
      white-space: nowrap;
      overflow: hidden;
    }
    .titlebar span.meta {
      font-weight: normal;
      color: #444;
      margin-left: 14px;
    }

    /* Menu bar */
    .menubar {
      background: #f3f3f3;
      border-bottom: 1px solid #9a9a9a;
      padding: 2px 4px;
    }
    .menuBtn {
      font-family: Tahoma, Arial, sans-serif;
      font-size: 12px;
      border: 1px solid #f3f3f3;
      background: #f3f3f3;
      padding: 2px 6px;
      margin-right: 2px;
      margin-bottom: 2px;
      cursor: pointer;
    }
    .menuBtnHover {
      border: 1px solid #cfcfcf;
      background: #ffffff;
    }
    .menuBtnActive {
      border: 1px solid #7aa7d9;
      background: #eaf2ff;
      font-weight: bold;
    }

    /* Main layout */
    .contentTable {
      width: 100%;
      border-collapse: collapse;
    }
    .contentRowWrap {
      position: relative;
    }
    .leftCell {
      position: absolute;
      left: 0;
      top: 0;
      right: 360px;
      bottom: 0;
      background: #c9c9ff;
      border-right: 2px solid #9a9a9a;
      overflow: auto;
    }
    .rightCell {
      position: absolute;
      right: 0;
      top: 0;
      width: 360px;
      bottom: 0;
      background: #e8e8ff;
      overflow: hidden;
    }

    /* Left header (logo + selectors) */
    .leftHeader {
      padding: 10px 12px 8px 12px;
    }
    .brandBox {
      border: 1px solid #9a9a9a;
      background: #d9d9ff;
      padding: 6px 8px;
      width: 310px;
    }
    .brandName {
      font-size: 28px;
      font-weight: bold;
      line-height: 28px;
    }
    .brandSub {
      color: #555;
      font-size: 12px;
      margin-top: 2px;
    }
    .selectorsBox {
      margin-top: 8px;
      text-align: right;
    }
    .selectorsBox label {
      font-weight: bold;
      margin-right: 6px;
    }
    .selectorsBox select {
      font-family: Tahoma, Arial, sans-serif;
      font-size: 12px;
      border: 1px solid #9a9a9a;
      background: #ffffff;
      padding: 2px;
      width: 120px;
      margin-bottom: 6px;
    }

    /* Left buttons area */
    .leftButtonsWrap {
      margin: 0 12px 10px 12px;
      border: 0px;
      overflow: auto;
      background: #c9c9ff;
    }
    .btnGrid {
      width: 100%;
      border-collapse: separate;
      border-spacing: 18px 16px;
    }
    .mfBtn {
      width: 100%;
      height: 54px;
      font-family: Tahoma, Arial, sans-serif;
      font-size: 13px;
      font-weight: bold;
      letter-spacing: 0.4px;
      background: #ececec;
      border: 2px solid #9a9a9a;
      border-top-color: #ffffff;
      border-left-color: #ffffff;
      cursor: pointer;
    }
    .mfBtn:hover {
      background: #f5f5f5;
    }
    .mfBtnActive {
      outline: 2px solid #7aa7d9;
    }

    /* Footer */
    .footer {
      /* Pinned to the bottom of the viewport rather than left to sit at the
         end of normal flow. In normal flow the footer's position depended on
         contentRow's computed height being exactly right; whenever that
         calculation ran even slightly long the whole footer slid below the
         window edge and the SETTINGS/EXIT buttons became unreachable. Anchored
         here it is always on screen no matter what contentRow does. */
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      background: #f0f0ff;
      border-top: 2px solid #9a9a9a;
      padding: 6px 10px;
    }
    .footerTable {
      width: 100%;
      border-collapse: collapse;
    }
    .footerTable td {
      /* 2026-08-31: explicit font-size — this document is in quirks mode (no
         DOCTYPE), where font-size is NOT inherited into a <table>. Without
         this, "Doctor:"/"Technician:" render at the default ~16px instead of
         the body's 12px, which both looked wrong and made the footer taller
         than its old hardcoded 56px, pushing the SETTINGS/EXIT buttons off
         the bottom of the window. Same quirk that hid the rx counts. */
      font-size: 12px;
      vertical-align: middle;
      padding-right: 8px;
      white-space: nowrap;
    }
    .footerInput {
      font-family: Tahoma, Arial, sans-serif;
      font-size: 12px;
      border: 1px solid #9a9a9a;
      padding: 3px 4px;
      width: 210px;
    }
    .footerBtn {
      font-family: Tahoma, Arial, sans-serif;
      font-size: 12px;
      font-weight: bold;
      background: #ececec;
      border: 2px solid #9a9a9a;
      border-top-color: #ffffff;
      border-left-color: #ffffff;
      padding: 6px 10px;
      cursor: pointer;
    }

    /* Right panel */
    .rxBox {
      background: #1d6fb8;
      color: #e9f4ff;
      font-family: "Courier New", monospace;
      font-size: 17px;
      padding: 8px 10px;
    }
    .rxRowItem {
      padding: 1px 0;
      white-space: nowrap;
      overflow: hidden;
    }
    .rxLabel {
      /* fixed width keeps the four counts in a column without pinning them
         to the far right edge of the 360px panel (that left a huge gap) */
      display: inline-block;
      width: 258px;
    }
    .rxNum {
      font-weight: bold;
    }

    .clockBox {
      background: #d6d6ff;
      border-bottom: 2px solid #9a9a9a;
      text-align: center;
      padding: 8px 8px 10px 8px;
    }
    .clockDate {
      font-family: "Courier New", monospace;
      font-size: 16px;
    }
    .clockTime {
      font-size: 40px;
      font-weight: bold;
      margin-top: 2px;
      line-height: 44px;
    }

    .workHeader {
      padding: 8px 8px 6px 8px;
    }
    .workTitle {
      font-weight: bold;
      font-size: 13px;
    }
    .workSub {
      font-size: 11px;
      color: #555;
      margin-top: 2px;
    }
    .filterRow {
      margin-top: 6px;
      text-align: right;
      white-space: nowrap;
    }
    .filterRow input {
      font-family: Tahoma, Arial, sans-serif;
      font-size: 12px;
      border: 1px solid #9a9a9a;
      padding: 2px 4px;
      width: 150px;
    }

    .listHeaderWrap {
      margin: 0 8px 0 8px;
      border: 1px solid #9a9a9a;
      border-bottom: 0px;
      background: #f2f2f2;
      overflow: hidden;
    
      zoom: 1;
          width: 344px;
}
    .listBodyWrap {
      margin: 0 8px 8px 8px;
      border: 1px solid #9a9a9a;
      background: #ffffff;
      overflow: scroll;
    
      zoom: 1;
          width: 344px;
}
    .listTable {
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 12px;
    }
    .listTh {
      border-bottom: 1px solid #cfcfcf;
      padding: 5px 6px;
      text-align: left;
      white-space: nowrap;
      background: #f2f2f2;
      cursor: default;
    }
    .listTd {
      border-bottom: 1px solid #eeeeee;
      padding: 5px 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .rowHover {
      background: #f7fbff;
    }
    .rowSelected {
      background: #dcecff;
    }
    .clickLink {
      color: #0066cc;
      text-decoration: underline;
      cursor: pointer;
    }

    .detailsBox {
      margin: 0 8px 10px 8px;
      border: 1px solid #9a9a9a;
      background: #fafafa;
      padding: 8px;
      overflow: auto;
          width: 344px;
}
    .detailsHdr {
      font-weight: bold;
      font-size: 13px;
      margin-bottom: 6px;
    }
    .pill {
      float: right;
      border: 1px solid #cfcfcf;
      background: #ffffff;
      padding: 2px 8px;
      font-size: 11px;
      color: #333;
    }
    .kvTable {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    .kvTable td {
      padding: 2px 0;
      vertical-align: top;
    }
    .kvKey { color: #555; width: 120px; }
    .kvVal { font-weight: bold; }

    /* Popup content (Visit Summary Notes / Encounter Details / Print Selected) */
    .popupWrap h2 {
      margin: 0 0 10px 0;
      font-size: 16px;
    }
    .popupWrap table {
      border-collapse: collapse;
      width: 100%;
      font-size: 12px;
    }
    .popupWrap td, .popupWrap th {
      border: 1px solid #c0c0c0;
      padding: 4px 6px;
      text-align: left;
      vertical-align: top;
    }
    .popupWrap .muted { color: #666666; }


    /* Modal overlay (IE6-friendly) */
    .overlay {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background: #000000;
      filter: alpha(opacity=35);
      opacity: 0.35;
      display: none;
      z-index: 1000;
    }
    .modal {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 820px;
      height: 520px;
      margin-left: -410px;
      margin-top: -260px;
      border: 2px solid #6f6f6f;
      background: #ffffff;
      display: none;
      z-index: 1001;
    }
    .modalHead {
      background: #e6e6e6;
      border-bottom: 1px solid #9a9a9a;
      padding: 8px 10px;
      font-weight: bold;
      font-size: 13px;
    }
    .modalBody {
      padding: 10px;
      height: 430px;
      overflow: auto;
      font-size: 12px;
    }
    .modalFoot {
      background: #f3f3f3;
      border-top: 1px solid #9a9a9a;
      padding: 8px 10px;
      text-align: right;
    }
    .modalBtn {
      font-family: Tahoma, Arial, sans-serif;
      font-size: 12px;
      font-weight: bold;
      background: #ececec;
      border: 2px solid #9a9a9a;
      border-top-color: #ffffff;
      border-left-color: #ffffff;
      padding: 6px 10px;
      cursor: pointer;
      margin-left: 8px;
    }

  
    /* Encounters window (Patient's Registration Details) */
    #encOverlay { z-index: 1100; }
    #encModal { z-index: 1101; }

    .encModal{
      position: absolute;
      left: 50%;
      top: 50%;
      width: 980px;
      height: 580px;
      margin-left: -490px;
      margin-top: -290px;
      border: 2px solid #6f6f6f;
      background: #ffffff;
      display: none;
    }
    .encHead{
      background: #e6e6e6;
      border-bottom: 1px solid #9a9a9a;
      padding: 6px 10px;
      font-weight: bold;
      font-size: 13px;
    }
    .encTabs{
      background: #efefef;
      border-bottom: 1px solid #c0c0c0;
      padding: 4px 6px;
      height: 28px;
      overflow: hidden;
      white-space: nowrap;
    }
    .tabBtn{
      font-size: 11px;
      padding: 3px 8px;
      border: 1px solid #c0c0c0;
      background: #f6f6f6;
      margin-right: 3px;
      cursor: pointer;
    }
    .tabBtnActive{
      background: #ffffff;
      border-bottom: 1px solid #ffffff;
      font-weight: bold;
    }
    .encBody{
      padding: 10px;
      height: 508px; /* 580 - (head+tabs+padding) approx */
      overflow: auto;
    }
    .encPane{ display: none; }
    .encPaneActive{ display: block; }

    .encTopLink{
      color: #0066cc;
      text-decoration: underline;
      cursor: pointer;
      font-size: 12px;
    }
    .encSectionTitle{
      margin: 10px 0 6px 0;
      font-size: 12px;
      font-weight: bold;
    }
    .encAddRow{
      margin: 4px 0 10px 0;
      font-size: 12px;
    }
    .encPlus{
      display: inline-block;
      width: 16px;
      height: 16px;
      text-align: center;
      line-height: 14px;
      border: 1px solid #2b8f2b;
      background: #4bd14b;
      color: #ffffff;
      font-weight: bold;
      margin-right: 6px;
      font-size: 12px;
    }
    .encAddLink{
      color: #cc0000;
      text-decoration: underline;
      cursor: pointer;
      font-weight: bold;
    }

    .encTableWrap{
      border: 1px solid #c0c0c0;
      background: #ffffff;
      height: 300px;
      overflow: auto;
    }
    .encTable{
      border-collapse: collapse;
      width: 100%;
      font-size: 12px;
      table-layout: fixed;
    }
    .encTable th, .encTable td{
      border: 1px solid #e0e0e0;
      padding: 4px 6px;
      vertical-align: middle;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .encTable th{
      background: #f6f6f6;
      font-weight: bold;
      text-align: left;
    }
    .encEditBtn{
      width: 24px;
      height: 20px;
      font-size: 11px;
      padding: 0;
    }
    .encRowHover{ background: #f1f6ff; }
    .encRowSelected{ background: #dbe9ff; }

    .encButtonRow{
      text-align: center;
      margin: 14px 0 0 0;
    }
    .encButton{
      padding: 4px 12px;
      font-size: 12px;
      border: 1px solid #9a9a9a;
      background: #efefef;
      cursor: pointer;
      margin: 0 6px;
    }
    .encCloseRow{
      text-align: right;
      margin-top: 14px;
    }
    .encCloseBtn{
      padding: 6px 18px;
      font-size: 12px;
      border: 2px solid #8b1f3b;
      background: #ffffff;
      cursor: pointer;
      font-weight: bold;
    }

</style>

  <script language="JScript">
  // ============================
  // Windows 2003 / IE6-safe JS
  // (RNG, formatters, data arrays, generatePatients/generateEncounters,
  // findPatientById/findEncounterById/getEncountersForPatient, and the DOM
  // helpers $/addEvent/setText/trim/toLower now live in shared/data.js —
  // loaded above via <script src>, shared with MedflowDetail.hta so a
  // patientId picked here resolves to the same person there.)
  // ============================
// --- State ---
  var state = {
    facility: "TC1",
    department: "Glaucoma",
    view: "glaucoma_followup",
    quickFilter: "",
    selectedRowId: "",
    sortKey: "",
    sortDir: "asc",
    currentRows: null,
    currentCols: null,
    currentEncounterPatientId: "",
    selectedEncounterId: "",
    encTab: "encounters"
  };

  // --- Views definition (IE6-safe) ---
  var VIEW_DEFS = null;

  function buildScheduleRows(dept, count){
    if (!count) count = 16;
    var pool = [];
    var i;
    for (i=0;i<DATA.patients.length;i++){
      var p = DATA.patients[i];
      if (p.department == dept && p.facility == state.facility){
        pool[pool.length] = p;
      }
    }
    if (pool.length < 6){
      // fallback to dept across all facilities
      pool = [];
      for (i=0;i<DATA.patients.length;i++){
        var p2 = DATA.patients[i];
        if (p2.department == dept){
          pool[pool.length] = p2;
        }
      }
    }
    // Shuffle (simple)
    var shuffled = pool.slice(0);
    for (i=0;i<shuffled.length;i++){
      var j = r(0, shuffled.length-1);
      var tmp = shuffled[i]; shuffled[i] = shuffled[j]; shuffled[j] = tmp;
    }
    var chosen = [];
    for (i=0;i<shuffled.length && chosen.length < count;i++){
      chosen[chosen.length] = shuffled[i];
    }

    var start = new Date();
    start.setHours(8,0,0,0);

    var rows = [];
    for (i=0;i<chosen.length;i++){
      var p3 = chosen[i];
      var appt = new Date(start.getTime() + i*15*60*1000);
      var reason = "";
      if (dept == "Glaucoma"){
        reason = pick(["IOP check","VF / HVF","OCT RNFL","Medication follow-up","Post-SLT check"]);
      } else if (dept == "Retina"){
        reason = pick(["OCT Macula","Dilated exam","Injection follow-up","FA imaging","Urgent symptoms"]);
      } else if (dept == "Pediatrics"){
        reason = p3.diagnosis;
      } else if (dept == "Contact Lenses"){
        reason = p3.diagnosis;
      } else if (dept == "Refractive"){
        reason = p3.diagnosis;
      } else if (dept == "Optical"){
        reason = p3.diagnosis;
      } else {
        reason = "Follow-up";
      }
      var status = pick(["Arrived","Checked in","Waiting","In testing","Ready for doctor"]);
      rows[rows.length] = {
        id: "A-" + dept + "-" + p3.id,
        patientId: p3.id,
        name: (dept=="Pediatrics") ? (p3.name + " (age " + p3.age + ")") : p3.name,
        time: formatTimeShort(appt),
        reason: reason,
        status: status
      };
    }
    return rows;
  }

  function buildWorkupRows(){
    var tasks = ["VA + Refraction","Tonometry","OCT setup","Visual field setup","Dilation","Drops education","Lensometry","History update"];
    var pr = ["Routine","High","Urgent"];
    var rows = [];
    var base = filterPatientsByContext();
    if (base.length < 1) base = DATA.patients;
    var i;
    for (i=0;i<base.length && rows.length < 18;i++){
      var p = base[i];
      rows[rows.length] = {
        id: "W-" + p.id,
        patientId: p.id,
        patient: p.name,
        task: pick(tasks),
        priority: (i % 9 == 0) ? "Urgent" : pick(pr)
      };
    }
    return rows;
  }

  function filterPatientsByContext(){
    var out = [];
    var i;
    for (i=0;i<DATA.patients.length;i++){
      var p = DATA.patients[i];
      if (p.facility == state.facility && p.department == state.department){
        out[out.length] = p;
      }
    }
    return out;
  }

  function buildPatientRegistryRows(){
    var list = filterPatientsByContext();
    if (list.length < 1){
      // fallback to department any facility
      list = [];
      var i;
      for (i=0;i<DATA.patients.length;i++){
        var p = DATA.patients[i];
        if (p.department == state.department){
          list[list.length] = p;
        }
      }
    }

    var rows = [];
    var i2;
    for (i2=0;i2<list.length;i2++){
      var p2 = list[i2];
      var iop = (p2.iopOD!=="" && p2.iopOS!=="") ? (p2.iopOD + "/" + p2.iopOS) : "—";
      var target = (p2.targetIOP && p2.targetIOP != 0) ? String(p2.targetIOP) : "—";
      var encCount = 0;
      if (DATA.encounters && DATA.encounters[p2.id]) encCount = DATA.encounters[p2.id].length;
      var medsShort = p2.meds;
      if (medsShort.length > 28) medsShort = medsShort.substring(0, 28) + "...";
      rows[rows.length] = {
        id: "R-" + p2.id,
        patientId: p2.id,
        mrn: p2.mrn,
        name: p2.name,
        sex: p2.sex,
        age: p2.age,
        diagnosis: p2.diagnosis,
        stage: p2.stage,
        iop: iop,
        target: target,
        encounters: encCount,
        last: formatDate(p2.lastVisit),
        next: formatDate(p2.nextAppt)
      };
    }
    return rows;
  }

  function defineViews(){
    VIEW_DEFS = {
      // main buttons
      single_screen: {
        title: function(){ return state.department + " Single Screen — Queue"; },
        sub: function(){ return "Facility " + state.facility + " • Department " + state.department; },
        columns: [
          {key:"name", label:"Name", width:180, sortable:1},
          {key:"time", label:"Time", width:80, sortable:1},
          {key:"status", label:"Status", width:120, sortable:1}
        ],
        rows: function(){ return buildScheduleRows(state.department, 16); }
      },
      specialized_exams: {
        title: function(){ return "Specialized Exams"; },
        sub: function(){ return "Facility " + state.facility + " • Department " + state.department; },
        columns: [
          {key:"exam", label:"Exam", width:160, sortable:1},
          {key:"template", label:"Template", width:220, sortable:1},
          {key:"notes", label:"Notes", width:260, sortable:0}
        ],
        rows: function(){
          var exams = [
            ["OCT RNFL","Glaucoma OCT RNFL","Confirm signal strength and scan quality"],
            ["OCT Macula","Retina OCT Macula","Verify laterality and macular cube"],
            ["HVF 24-2","Visual Field 24-2","Ensure proper lens and fixation monitoring"],
            ["HVF 10-2","Visual Field 10-2","Use 10-2 for advanced glaucoma or central defects"],
            ["Pachymetry","CCT Measurement","Record OD/OS and calibrate device"],
            ["Fundus Photos","Color Photos","Center disc/macula as appropriate"],
            ["Gonioscopy","Angle Evaluation","Document Shaffer grade / PAS if present"],
            ["Topography","Corneal Topo","Refractive screening and irregular astigmatism check"]
          ];
          var rows = [];
          var i;
          for (i=0;i<exams.length;i++){
            rows[rows.length] = { id: "EX-" + i, exam: exams[i][0], template: exams[i][1], notes: exams[i][2] };
          }
          return rows;
        }
      },
      refractive_exam: {
        title: function(){ return "Refractive Exam — Queue"; },
        sub: function(){ return "Facility " + state.facility; },
        columns: [
          {key:"name", label:"Name", width:180, sortable:1},
          {key:"time", label:"Time", width:80, sortable:1},
          {key:"reason", label:"Reason", width:240, sortable:0}
        ],
        rows: function(){ return buildScheduleRows("Refractive", 14); }
      },
      glaucoma_followup: {
        title: function(){ return "Glaucoma Follow Up — Queue"; },
        sub: function(){ return "Facility " + state.facility; },
        columns: [
