  // --- UI updates ---
  function updateRxCounts(){
    var relevant = [];
    var i;
    for (i=0;i<DATA.patients.length;i++){
      var p = DATA.patients[i];
      if (p.facility == state.facility && p.department == state.department){
        relevant[relevant.length] = p;
      }
    }
    if (relevant.length < 1){
      for (i=0;i<DATA.patients.length;i++){
        var p2 = DATA.patients[i];
        if (p2.department == state.department) relevant[relevant.length] = p2;
      }
    }
    var counts = {pending:0, refill:0, change:0, needsigning:0};
    for (i=0;i<relevant.length;i++){
      var s = relevant[i].rxStatus;
      if (s == "pending") counts.pending++;
      else if (s == "refill") counts.refill++;
      else if (s == "change") counts.change++;
      else if (s == "needsigning") counts.needsigning++;
    }
    setText($("rxPending"), String(counts.pending));
    setText($("rxRefill"), String(counts.refill));
    setText($("rxChange"), String(counts.change));
    setText($("rxNeedSigning"), String(counts.needsigning));
  }

  // IE-safe table build helpers (NO innerHTML on TABLE/TBODY/TR)
  function clearTable(tbl){
    // delete all rows
    while (tbl.rows.length > 0){
      tbl.deleteRow(0);
    }
  }

  function getCurrentView(){
    if (!VIEW_DEFS) return null;
    return VIEW_DEFS[state.view] ? VIEW_DEFS[state.view] : VIEW_DEFS["glaucoma_followup"];
  }

  function applyFilter(rows, cols, q){
    q = toLower(trim(q));
    if (!q) return rows;

    var out = [];
    var i;
    for (i=0;i<rows.length;i++){
      var row = rows[i];
      var hay = "";
      var c;
      for (c=0;c<cols.length;c++){
        var key = cols[c].key;
        hay += " " + String(row[key]);
      }
      if (toLower(hay).indexOf(q) >= 0){
        out[out.length] = row;
      }
    }
    return out;
  }

  function sortRows(rows, key, dir){
    if (!key) return rows;
    var sorted = rows.slice(0);
    sorted.sort(function(a,b){
      var av = a[key];
      var bv = b[key];
      if (av === null || typeof av === "undefined") av = "";
      if (bv === null || typeof bv === "undefined") bv = "";

      // numeric check
      var an = parseFloat(av);
      var bn = parseFloat(bv);
      var aIsNum = !isNaN(an) && String(av).replace(/^\s+|\s+$/g,'').match(/^-?\d+(\.\d+)?$/);
      var bIsNum = !isNaN(bn) && String(bv).replace(/^\s+|\s+$/g,'').match(/^-?\d+(\.\d+)?$/);
      var cmp;
      if (aIsNum && bIsNum){
        cmp = an - bn;
      } else {
        av = toLower(String(av));
        bv = toLower(String(bv));
        if (av < bv) cmp = -1;
        else if (av > bv) cmp = 1;
        else cmp = 0;
      }
      return (dir == "asc") ? cmp : -cmp;
    });
    return sorted;
  }

  function renderView(){
    var def = getCurrentView();
    if (!def) return;

    // titles
    setText($("viewTitle"), def.title());
    setText($("viewSub"), def.sub());

    // build rows
    var cols = def.columns;
    var rows = def.rows();

    // apply filter
    rows = applyFilter(rows, cols, state.quickFilter);

    // sort
    rows = sortRows(rows, state.sortKey, state.sortDir);

    state.currentRows = rows;
    state.currentCols = cols;

    // Header table
    var hdrTbl = $("listHeaderTable");
    clearTable(hdrTbl);
    var hr = hdrTbl.insertRow(0);
    var totalW = 0;
    var i;
    for (i=0;i<cols.length;i++){
      var c = cols[i];
      var th = document.createElement("td");
      th.className = "listTh";
      th.id = "hdr_" + c.key;
      th.style.width = (c.width ? c.width : 120) + "px";
      totalW += (c.width ? c.width : 120);

      // clickable sort headers
      if (c.sortable){
        th.style.cursor = "pointer";
        th.title = "Click to sort";
        // closure-safe handler: attach key via attribute
        th._sortkey = c.key;
        addEvent(th, "click", onHeaderClick);
      }
      setText(th, c.label + ((state.sortKey == c.key) ? (state.sortDir=="asc" ? "  ▲" : "  ▼") : ""));
      hr.appendChild(th);
    }
    hdrTbl.style.width = totalW + "px";

    // Body table
    var bodyTbl = $("listBodyTable");
    clearTable(bodyTbl);
    bodyTbl.style.width = totalW + "px";

    for (i=0;i<rows.length;i++){
      var row = rows[i];
      var tr = bodyTbl.insertRow(bodyTbl.rows.length);
      tr._rowid = row.id;
      tr._patientid = row.patientId ? row.patientId : "";
      tr.className = "";
      // hover
      addEvent(tr, "mouseover", onRowOver);
      addEvent(tr, "mouseout", onRowOut);
      addEvent(tr, "click", onRowClick);
      addEvent(tr, "dblclick", onRowDblClick);

      var j;
      for (j=0;j<cols.length;j++){
        var col = cols[j];
        var td = tr.insertCell(tr.cells.length);
        td.className = "listTd";
        td.style.width = (col.width ? col.width : 120) + "px";
        // 2026-08-27: <tr> itself is never materialized as its own UIA
        // element in this MSHTML bridge (Table -> cell DataItem directly,
        // no row-level node) — a click physically inside this <td> still
        // reaches the row's click/dblclick listeners via normal DOM
        // bubbling, so the id lives on the first cell instead of the <tr>.
        if (j === 0){
          td.id = "row_" + String(row.id).replace(/[^A-Za-z0-9_-]/g, "_");
        }
        var val = row[col.key];
        if (typeof val === "undefined" || val === null) val = "";

        // Encounters column opens the Encounters window (like Medflow)
        if (col.key == "encounters" && row.patientId){
          // <a>, not <span> — 2026-08-27 실측: MSHTML의 UIA 브리지는 <td>
          // 안에 중첩된 <span>을 독립 요소로 노출하지 않는다(부모 td의
          // DataItem으로 흡수됨). <a>와 <input>은 중첩돼도 자기 자신의
          // AutomationId를 그대로 유지한다(scratch 검증 완료).
          var link = document.createElement("a");
          link.className = "clickLink";
          link.id = "enclink_" + row.patientId;
          link._pid = row.patientId;
          setText(link, String(val));
          addEvent(link, "click", onEncounterLinkClick);
          td.appendChild(link);
        } else {
          setText(td, String(val));
        }
      }

      // mark selected
      if (row.id == state.selectedRowId){
        tr.className = "rowSelected";
      }
    }

    // Update selection / details
    if (rows.length > 0){
      // if no selection, auto-select first
      if (!state.selectedRowId){
        state.selectedRowId = rows[0].id;
      } else {
        // if selection not present anymore, select first
        var found = false;
        for (i=0;i<rows.length;i++){
          if (rows[i].id == state.selectedRowId) { found = true; break; }
        }
        if (!found) state.selectedRowId = rows[0].id;
      }
    } else {
      state.selectedRowId = "";
    }
    highlightSelection();
    renderDetails();
  }

  function highlightSelection(){
    var bodyTbl = $("listBodyTable");
    var i;
    for (i=0;i<bodyTbl.rows.length;i++){
      var tr = bodyTbl.rows[i];
      var rid = tr._rowid;
      if (rid == state.selectedRowId){
        tr.className = "rowSelected";
      } else {
        tr.className = "";
      }
    }
  }

  function findRowById(rowId){
    // use currentRows
    if (!state.currentRows) return null;
    var i;
    for (i=0;i<state.currentRows.length;i++){
      if (state.currentRows[i].id == rowId) return state.currentRows[i];
    }
    return null;
  }

  // findPatientById: provided by shared/data.js

  function renderDetails(){
    var pill = $("selectionPill");
    var box = $("detailsBody");

    if (!state.selectedRowId){
      setText(pill, "No selection");
      box.innerHTML = "<span style='color:#555;'>Select a row in the list to view details.</span>";
      return;
    }
    var row = findRowById(state.selectedRowId);
    if (!row){
      setText(pill, "No selection");
      box.innerHTML = "<span style='color:#555;'>Select a row in the list to view details.</span>";
      return;
    }
    var pid = row.patientId;
    var patient = findPatientById(pid);

    if (patient){
      setText(pill, patient.name);

      var html = "<table class='kvTable'>";
      html += "<tr><td class='kvKey'>MRN</td><td class='kvVal'>" + patient.mrn + "</td></tr>";
      html += "<tr><td class='kvKey'>DOB</td><td class='kvVal'>" + formatDate(patient.dob) + " (Age " + patient.age + ")</td></tr>";
      html += "<tr><td class='kvKey'>Sex</td><td class='kvVal'>" + patient.sex + "</td></tr>";
      html += "<tr><td class='kvKey'>Phone</td><td class='kvVal'>" + patient.phone + "</td></tr>";
      html += "<tr><td class='kvKey'>Facility</td><td class='kvVal'>" + patient.facility + "</td></tr>";
      html += "<tr><td class='kvKey'>Department</td><td class='kvVal'>" + patient.department + "</td></tr>";
      html += "<tr><td class='kvKey'>Provider</td><td class='kvVal'>" + patient.provider + "</td></tr>";

      if (patient.department == "Glaucoma"){
        html += "<tr><td class='kvKey'>Dx / Stage</td><td class='kvVal'>" + patient.diagnosis + " • " + patient.stage + "</td></tr>";
        html += "<tr><td class='kvKey'>Laterality</td><td class='kvVal'>" + patient.laterality + "</td></tr>";
        html += "<tr><td class='kvKey'>IOP (OD/OS)</td><td class='kvVal'>" + patient.iopOD + "/" + patient.iopOS + " mmHg</td></tr>";
        html += "<tr><td class='kvKey'>Target IOP</td><td class='kvVal'>" + patient.targetIOP + " mmHg</td></tr>";
        html += "<tr><td class='kvKey'>CCT (OD/OS)</td><td class='kvVal'>" + patient.cctOD + "/" + patient.cctOS + " µm</td></tr>";
        html += "<tr><td class='kvKey'>C/D (OD/OS)</td><td class='kvVal'>" + patient.cdOD + "/" + patient.cdOS + "</td></tr>";
        html += "<tr><td class='kvKey'>VF MD (OD/OS)</td><td class='kvVal'>" + patient.vfMD_OD + "/" + patient.vfMD_OS + " dB</td></tr>";
        html += "<tr><td class='kvKey'>RNFL (OD/OS)</td><td class='kvVal'>" + patient.rnflOD + "/" + patient.rnflOS + " µm</td></tr>";
        html += "<tr><td class='kvKey'>Meds</td><td class='kvVal'>" + patient.meds + "</td></tr>";
      } else {
        html += "<tr><td class='kvKey'>Reason</td><td class='kvVal'>" + patient.diagnosis + "</td></tr>";
        if (patient.iopOD !== "" && patient.iopOS !== ""){
          html += "<tr><td class='kvKey'>IOP (OD/OS)</td><td class='kvVal'>" + patient.iopOD + "/" + patient.iopOS + " mmHg</td></tr>";
        }
        if (patient.cctOD !== "" && patient.cctOS !== ""){
          html += "<tr><td class='kvKey'>CCT (OD/OS)</td><td class='kvVal'>" + patient.cctOD + "/" + patient.cctOS + " µm</td></tr>";
        }
        html += "<tr><td class='kvKey'>Notes</td><td class='kvVal'>" + patient.notes + "</td></tr>";
      }
      html += "<tr><td class='kvKey'>Last Visit</td><td class='kvVal'>" + formatDate(patient.lastVisit) + "</td></tr>";
      html += "<tr><td class='kvKey'>Next Appt</td><td class='kvVal'>" + formatDate(patient.nextAppt) + "</td></tr>";
      html += "</table>";

      html += "<div style='margin-top:8px;color:#555;'><b>Tip:</b> Double-click a row to open Patient Detail in a new window. <a class='clickLink' id='inlineRecordLink'>View inline summary</a></div>";
      box.innerHTML = html;
      addEvent($("inlineRecordLink"), "click", openRecordModal);
    } else {
      // non-patient row
      setText(pill, "Selected");
      var html2 = "<table class='kvTable'>";
      var cols = state.currentCols;
      var i2;
      for (i2=0;i2<cols.length;i2++){
        var k = cols[i2].key;
        html2 += "<tr><td class='kvKey'>" + cols[i2].label + "</td><td class='kvVal'>" + String(row[k]) + "</td></tr>";
      }
      html2 += "</table>";
      box.innerHTML = html2;
    }
  }

  // --- Modal (patient record) ---
  function openRecordModal(){
    if (!state.selectedRowId) return;
    var row = findRowById(state.selectedRowId);
    if (!row) return;

    var pid = row.patientId;
    var patient = findPatientById(pid);

    if (!patient){
      // for non-patient rows show generic
      $("modalTitle").innerText = "Details";
      $("modalBody").innerHTML = $("detailsBody").innerHTML;
      showModal();
      return;
    }

    $("modalTitle").innerText = patient.name + " — Patient Record";

    var html = "";
    html += "<table class='kvTable'>";
    html += "<tr><td class='kvKey'>MRN</td><td class='kvVal'>" + patient.mrn + "</td></tr>";
    html += "<tr><td class='kvKey'>DOB</td><td class='kvVal'>" + formatDate(patient.dob) + " (Age " + patient.age + ")</td></tr>";
    html += "<tr><td class='kvKey'>Sex</td><td class='kvVal'>" + patient.sex + "</td></tr>";
    html += "<tr><td class='kvKey'>Phone</td><td class='kvVal'>" + patient.phone + "</td></tr>";
    html += "<tr><td class='kvKey'>Facility</td><td class='kvVal'>" + patient.facility + "</td></tr>";
    html += "<tr><td class='kvKey'>Department</td><td class='kvVal'>" + patient.department + "</td></tr>";
    html += "<tr><td class='kvKey'>Provider</td><td class='kvVal'>" + patient.provider + "</td></tr>";
    html += "<tr><td class='kvKey'>Technician</td><td class='kvVal'>" + patient.technician + "</td></tr>";
    html += "<tr><td class='kvKey'>Diagnosis</td><td class='kvVal'>" + patient.diagnosis + "</td></tr>";
    html += "<tr><td class='kvKey'>Stage</td><td class='kvVal'>" + patient.stage + "</td></tr>";
    if (patient.department == "Glaucoma"){
      html += "<tr><td class='kvKey'>Laterality</td><td class='kvVal'>" + patient.laterality + "</td></tr>";
      html += "<tr><td class='kvKey'>IOP (OD/OS)</td><td class='kvVal'>" + patient.iopOD + "/" + patient.iopOS + " mmHg</td></tr>";
      html += "<tr><td class='kvKey'>Target IOP</td><td class='kvVal'>" + patient.targetIOP + " mmHg</td></tr>";
      html += "<tr><td class='kvKey'>CCT (OD/OS)</td><td class='kvVal'>" + patient.cctOD + "/" + patient.cctOS + " µm</td></tr>";
      html += "<tr><td class='kvKey'>C/D (OD/OS)</td><td class='kvVal'>" + patient.cdOD + "/" + patient.cdOS + "</td></tr>";
      html += "<tr><td class='kvKey'>VF MD (OD/OS)</td><td class='kvVal'>" + patient.vfMD_OD + "/" + patient.vfMD_OS + " dB</td></tr>";
      html += "<tr><td class='kvKey'>RNFL (OD/OS)</td><td class='kvVal'>" + patient.rnflOD + "/" + patient.rnflOS + " µm</td></tr>";
      html += "<tr><td class='kvKey'>Meds</td><td class='kvVal'>" + patient.meds + "</td></tr>";
    }
    html += "<tr><td class='kvKey'>Last Visit</td><td class='kvVal'>" + formatDate(patient.lastVisit) + "</td></tr>";
    html += "<tr><td class='kvKey'>Next Appt</td><td class='kvVal'>" + formatDate(patient.nextAppt) + "</td></tr>";
    html += "<tr><td class='kvKey'>RX Status</td><td class='kvVal'>" + patient.rxStatus + "</td></tr>";
    html += "</table>";

    $("modalBody").innerHTML = html;
    showModal();
  }

  function showModal(){
    var ov = $("overlay");
    var md = $("modal");
    // Ensure modal sits above the Encounters window when launched from there.
    if (ov){
      ov.style.zIndex = 1200;
      ov.style.display = "block";
    }
    if (md){
      md.style.zIndex = 1201;
      md.style.display = "block";
    }
  }
  function closeModal(){
    $("overlay").style.display = "none";
    $("modal").style.display = "none";
  }


  // --- Encounters Window (Patient's Registration Details) ---
  function onEncounterLinkClick(){
    var el = window.event ? window.event.srcElement : this;
    // climb up to element that has _pid
    while (el && typeof el._pid === "undefined" && el.parentNode){
      el = el.parentNode;
    }
    if (el && el._pid){
      openEncountersModal(el._pid);
    }
    if (window.event){
      window.event.cancelBubble = true;
      window.event.returnValue = false;
    }
    return false;
  }

  function showEncModal(){
    $("encOverlay").style.display = "block";
    $("encModal").style.display = "block";
  }

  function closeEncModal(){
    $("encOverlay").style.display = "none";
    $("encModal").style.display = "none";
    state.currentEncounterPatientId = "";
    state.selectedEncounterId = "";
  }

  function onEncTabClick(){
    var el = window.event ? window.event.srcElement : this;
    if (!el) return;
    // in IE, click may be on INPUT itself
    var id = el.id ? el.id : "";
    if (id.indexOf("encTab_") !== 0) return;
    var key = id.substring(7);
    setEncTab(key);
  }

  function setEncTab(tabKey){
    state.encTab = tabKey;

    var keys = ["search","demos","insurances","preauth","contacts","summary","appointments","followup","documents","encounters","bills","notes","pharmacies","rx","intakeforms"];
    var i;
    for (i=0;i<keys.length;i++){
      var k = keys[i];
      var btn = $("encTab_" + k);
      if (btn){
        btn.className = (k == tabKey) ? "tabBtn tabBtnActive" : "tabBtn";
      }
      var pane = $("encPane_" + k);
      if (pane){
        pane.className = (k == tabKey) ? "encPane encPaneActive" : "encPane";
      }
    }
  }

  function openEncountersModal(patientId){
    var p = findPatientById(patientId);
    if (!p) return;

    state.currentEncounterPatientId = patientId;
    state.selectedEncounterId = "";

    var gender = (p.sex == "M") ? "Male" : "Female";
    setText($("encTitle"), "Patient's Registration Details [ " + p.mrn + " ], " + p.name + ", " + p.age + " Years, " + gender);

    setEncTab("encounters");
    renderEncountersTable(patientId);
    showEncModal();
  }

  // getEncountersForPatient / findEncounterById: provided by shared/data.js

  function renderEncountersTable(patientId){
    var tbody = $("encTableBody");
    if (!tbody) return;

    // clear tbody
    while (tbody.rows.length > 0){
      tbody.deleteRow(0);
    }

    var list = getEncountersForPatient(patientId);
    if (!list || list.length < 1){
      var tr0 = tbody.insertRow(tbody.rows.length);
      var td0 = tr0.insertCell(0);
      td0.colSpan = 8;
      td0.style.textAlign = "center";
      td0.style.color = "#666666";
      td0.style.padding = "18px";
      setText(td0, "No encounters found for this patient.");
      return;
    }

    var i;
    for (i=0;i<list.length;i++){
      var enc = list[i];

      var tr = tbody.insertRow(tbody.rows.length);
      tr._encid = enc.id;
      tr._pid = patientId;
      // (no id on <tr> itself — see the row-list comment above; MSHTML never
      // materializes a UIA element for the <tr>, only for its cells)

      addEvent(tr, "mouseover", onEncRowOver);
      addEvent(tr, "mouseout", onEncRowOut);
      addEvent(tr, "click", onEncRowClick);

      // Encounter Id
      var tdId = tr.insertCell(tr.cells.length);
      var idLink = document.createElement("a"); // <a>, see the encounters-column comment above
      idLink.className = "clickLink";
      idLink.id = "encidlink_" + enc.id;
      idLink._encid = enc.id;
      idLink._pid = patientId;
      setText(idLink, String(enc.id));
      addEvent(idLink, "click", onEncIdClick);
      tdId.appendChild(idLink);

      // Provider Name — carries the row-select id (see row-list comment
      // above: a click here still reaches the row's own click handler via
      // DOM bubbling)
      var tdProv = tr.insertCell(tr.cells.length);
      tdProv.id = "encrow_" + enc.id;
      setText(tdProv, enc.providerName);

      // Facility Name
      var tdFac = tr.insertCell(tr.cells.length);
      setText(tdFac, enc.facilityName);

      // Date
      var tdDate = tr.insertCell(tr.cells.length);
      setText(tdDate, formatDate(enc.date));

      // Description
      var tdDesc = tr.insertCell(tr.cells.length);
      setText(tdDesc, enc.description);

      // Edit
      var tdEdit = tr.insertCell(tr.cells.length);
      tdEdit.style.textAlign = "center";
      var editBtn = document.createElement("input");
      editBtn.type = "button";
      editBtn.value = "E";
      editBtn.title = "Edit encounter";
      editBtn.className = "encEditBtn";
      editBtn.id = "encedit_" + enc.id;
      editBtn._encid = enc.id;
      editBtn._pid = patientId;
      addEvent(editBtn, "click", onEditEncounter);
      tdEdit.appendChild(editBtn);

      // Visit Summary Notes
      var tdSum = tr.insertCell(tr.cells.length);
      if (enc.hasSummary){
        var sumLink = document.createElement("a"); // <a>, see the encounters-column comment above
        sumLink.className = "clickLink";
        sumLink.id = "encsum_" + enc.id;
        sumLink._encid = enc.id;
        sumLink._pid = patientId;
        setText(sumLink, "Visit Summary Notes");
        addEvent(sumLink, "click", onVisitSummaryClick);
        tdSum.appendChild(sumLink);
      } else {
        setText(tdSum, "");
      }

      // Select To Print
      var tdChk = tr.insertCell(tr.cells.length);
      tdChk.style.textAlign = "center";
      var cb = document.createElement("input");
      cb.type = "checkbox";
      cb.id = "encchk_" + enc.id;
      cb._encid = enc.id;
      tdChk.appendChild(cb);

      // selected state
      if (String(state.selectedEncounterId) != "" && String(state.selectedEncounterId) == String(enc.id)){
        tr.className = "encRowSelected";
      }
    }
  }

  function getEventRow(){
    var el = window.event ? window.event.srcElement : null;
    while (el && el.tagName && el.tagName.toLowerCase() != "tr"){
      el = el.parentNode;
    }
    return el;
  }

  function onEncRowOver(){
    var tr = getEventRow();
    if (!tr) return;
    if (tr.className != "encRowSelected"){
      tr.className = "encRowHover";
    }
  }
  function onEncRowOut(){
    var tr = getEventRow();
    if (!tr) return;
    if (String(tr._encid) == String(state.selectedEncounterId)){
      tr.className = "encRowSelected";
    } else {
      tr.className = "";
    }
  }
  function onEncRowClick(){
    var tr = getEventRow();
    if (!tr) return;
    state.selectedEncounterId = tr._encid;
    // repaint selection
    var tbody = $("encTableBody");
    var i;
    for (i=0;i<tbody.rows.length;i++){
      var r = tbody.rows[i];
      if (String(r._encid) == String(state.selectedEncounterId)){
        r.className = "encRowSelected";
      } else {
        r.className = "";
      }
    }
  }

  function onEncIdClick(){
    // Click on Encounter Id: select row and open details window
    var el = window.event ? window.event.srcElement : this;
    while (el && typeof el._encid === "undefined" && el.parentNode){
      el = el.parentNode;
    }
    if (!el) return false;

    state.selectedEncounterId = el._encid;
    onEncRowClick(); // highlight

    var enc = findEncounterById(el._pid, el._encid);
    if (enc){
      openEncounterDetails(enc);
    }

    if (window.event){
      window.event.cancelBubble = true;
      window.event.returnValue = false;
    }
    return false;
  }

  function onEditEncounter(){
    var el = window.event ? window.event.srcElement : this;
    if (!el) return false;

    var enc = findEncounterById(el._pid, el._encid);
    if (!enc) return false;

    var newDesc = prompt("Edit description:", enc.description);
    if (newDesc !== null){
      enc.description = newDesc;
      renderEncountersTable(el._pid);
    }

    if (window.event){
      window.event.cancelBubble = true;
      window.event.returnValue = false;
    }
    return false;
  }

  function onVisitSummaryClick(){
    var el = window.event ? window.event.srcElement : this;
    while (el && typeof el._encid === "undefined" && el.parentNode){
      el = el.parentNode;
    }
    if (!el) return false;

    var enc = findEncounterById(el._pid, el._encid);
    if (enc){
      openVisitSummary(enc);
    }

    if (window.event){
      window.event.cancelBubble = true;
      window.event.returnValue = false;
    }
    return false;
  }

  function escapeHtml(s){
    s = String(s);
    s = s.replace(/&/g, "&amp;");
    s = s.replace(/</g, "&lt;");
    s = s.replace(/>/g, "&gt;");
    s = s.replace(/\"/g, "&quot;");
    return s;
  }

  function openPopupHtml(title, bodyHtml){
    // NOTE (Win2003/IE6): window.open() can throw "Access is denied" depending on IE security/popup settings.
    // To keep this HTA stable, render the popup content inside the built-in modal instead.
    $("modalTitle").innerText = String(title);
    $("modalBody").innerHTML = "<div class='popupWrap'>" + String(bodyHtml) + "</div>";
    showModal();
    return null;
  }

  function openEncounterDetails(enc){
    var p = findPatientById(enc.patientId);
    var html = '';
    html += '<h2>Encounter #' + escapeHtml(enc.id) + '</h2>';
    if (p){
      html += '<div class="muted"><b>Patient:</b> ' + escapeHtml(p.name) + ' &nbsp; <b>MRN:</b> ' + escapeHtml(p.mrn) + '</div>';
      html += '<div class="muted"><b>Department:</b> ' + escapeHtml(p.department) + ' &nbsp; <b>Facility:</b> ' + escapeHtml(p.facility) + '</div>';
      html += '<br />';
    }
    html += '<table><tr><th style="width:160px;">Provider</th><td>' + escapeHtml(enc.providerName) + '</td></tr>';
    html += '<tr><th>Facility</th><td>' + escapeHtml(enc.facilityName) + '</td></tr>';
    html += '<tr><th>Date</th><td>' + escapeHtml(formatDate(enc.date)) + '</td></tr>';
    html += '<tr><th>Description</th><td>' + escapeHtml(enc.description) + '</td></tr></table>';
    openPopupHtml("Encounter " + enc.id, html);
  }

  function openVisitSummary(enc){
    var p = findPatientById(enc.patientId);
    var html = '';
    html += '<h2>Visit Summary Notes - Encounter #' + escapeHtml(enc.id) + '</h2>';
    if (p){
      html += '<div class="muted"><b>Patient:</b> ' + escapeHtml(p.name) + ' &nbsp; <b>MRN:</b> ' + escapeHtml(p.mrn) + '</div>';
      html += '<div class="muted"><b>DOB:</b> ' + escapeHtml(formatDate(p.dob)) + ' (Age ' + escapeHtml(p.age) + ') &nbsp; <b>Sex:</b> ' + escapeHtml(p.sex) + '</div>';
      html += '<div class="muted"><b>Diagnosis:</b> ' + escapeHtml(p.diagnosis) + '</div>';
      html += '<br />';
    }
    html += '<table>';
    html += '<tr><th style="width:180px;">Assessment</th><td>Stable. Continue current management plan.</td></tr>';
    html += '<tr><th>Plan</th><td>Follow-up as scheduled. Reinforce medication compliance.</td></tr>';
    if (p && p.department == "Glaucoma"){
      html += '<tr><th>IOP OD/OS</th><td>' + escapeHtml(p.iopOD + "/" + p.iopOS) + ' mmHg &nbsp; (Target ' + escapeHtml(p.targetIOP) + ')</td></tr>';
      html += '<tr><th>Medications</th><td>' + escapeHtml(p.meds) + '</td></tr>';
      html += '<tr><th>Notes</th><td>OCT / VF reviewed. No progression noted.</td></tr>';
    } else {
      html += '<tr><th>Notes</th><td>Routine follow-up documentation.</td></tr>';
    }
    html += '</table>';
    openPopupHtml("Visit Summary Notes", html);
  }

  function onAddNewPatient(){
    if (window.event){
      window.event.returnValue = false;
      window.event.cancelBubble = true;
    }
    alert("Add New Patient is available in the full system.");
    return false;
  }

  function onAddEncounter(){
    if (window.event){
      window.event.returnValue = false;
      window.event.cancelBubble = true;
    }
    var pid = state.currentEncounterPatientId;
    if (!pid) return false;

    var list = getEncountersForPatient(pid);

    // compute new id
    var maxId = 0;
    var i;
    for (i=0;i<list.length;i++){
      if (list[i].id > maxId) maxId = list[i].id;
    }
    var newId = (maxId > 0) ? (maxId + 1) : (800 + r(0, 150));

    list[list.length] = {
      id: newId,
      patientId: pid,
      providerName: pick(PROVIDERS),
      facilityName: state.facility,
      date: new Date(),
      description: "Follow-Up",
      hasSummary: 1
    };

    // newest first
    list.sort(function(a,b){ return b.date - a.date; });

    // update encounters count in Patient Data list behind the modal
    renderView();
    renderEncountersTable(pid);
    return false;
  }

  function getSelectedEncounterIds(){
    var ids = [];
    var tbody = $("encTableBody");
    if (!tbody) return ids;

    var inputs = tbody.getElementsByTagName("input");
    var i;
    for (i=0;i<inputs.length;i++){
      var inp = inputs[i];
      if (inp && inp.type == "checkbox" && inp.checked){
        ids[ids.length] = inp._encid;
      }
    }
    return ids;
  }

  function onViewPdf(){
    if (window.event){
      window.event.returnValue = false;
      window.event.cancelBubble = true;
    }

    var pid = state.currentEncounterPatientId;
    if (!pid) return false;

    var list = getEncountersForPatient(pid);
    if (!list || list.length < 1){
      alert("No encounters available.");
      return false;
    }

    var enc = null;

    // Prefer selected encounter
    if (state.selectedEncounterId){
      enc = findEncounterById(pid, state.selectedEncounterId);
    }

    // Otherwise first checked
    if (!enc){
      var selected = getSelectedEncounterIds();
      if (selected.length > 0){
        enc = findEncounterById(pid, selected[0]);
      }
    }

    // Otherwise most recent
    if (!enc){
      enc = list[0];
    }

    // "View PDF" (HTML preview) for the selected encounter
    openVisitSummary(enc);
    return false;
  }

  function onPrintSelected(){
    if (window.event){
      window.event.returnValue = false;
      window.event.cancelBubble = true;
    }

    var pid = state.currentEncounterPatientId;
    if (!pid) return false;

    var ids = getSelectedEncounterIds();
    if (ids.length < 1){
      alert("Please select at least one encounter to print.");
      return false;
    }

    var p = findPatientById(pid);
    var html = '';
    html += '<h2>Selected Encounters</h2>';
    if (p){
      html += '<div class="muted"><b>Patient:</b> ' + escapeHtml(p.name) + ' &nbsp; <b>MRN:</b> ' + escapeHtml(p.mrn) + '</div><br />';
    }

    html += '<table>';
    html += '<tr><th style="width:90px;">Encounter Id</th><th style="width:160px;">Provider</th><th style="width:120px;">Facility</th><th style="width:90px;">Date</th><th>Description</th></tr>';

    var i;
    for (i=0;i<ids.length;i++){
      var enc = findEncounterById(pid, ids[i]);
      if (enc){
        html += '<tr><td>' + escapeHtml(enc.id) + '</td><td>' + escapeHtml(enc.providerName) + '</td><td>' + escapeHtml(enc.facilityName) + '</td><td>' + escapeHtml(formatDate(enc.date)) + '</td><td>' + escapeHtml(enc.description) + '</td></tr>';
      }
    }
    html += '</table>';

    openPopupHtml("Print Selected", html);
    return false;
  }


  // --- Events ---
  function onHeaderClick(){
    // In attachEvent, "this" can be window, so use event.srcElement.
    var el = window.event ? window.event.srcElement : this;
    if (!el) return;

    // Ensure we have the header cell
    while (el && el.tagName && el.tagName.toLowerCase() != "td" && el.parentNode){
      el = el.parentNode;
    }
    var key = el._sortkey;
    if (!key) return;

    if (state.sortKey == key){
      state.sortDir = (state.sortDir == "asc") ? "desc" : "asc";
    } else {
      state.sortKey = key;
      state.sortDir = "asc";
    }
    renderView();
  }

  
  function onRowOver(){
    var tr = window.event ? window.event.srcElement : this;
    // might hit td, climb to tr
    while (tr && tr.tagName && tr.tagName.toLowerCase() != "tr"){
      tr = tr.parentNode;
    }
    if (!tr) return;
    if (tr._rowid != state.selectedRowId){
      tr.className = "rowHover";
    }
  }
  function onRowOut(){
    var tr = window.event ? window.event.srcElement : this;
    while (tr && tr.tagName && tr.tagName.toLowerCase() != "tr"){
      tr = tr.parentNode;
    }
    if (!tr) return;
    if (tr._rowid == state.selectedRowId){
      tr.className = "rowSelected";
    } else {
      tr.className = "";
    }
  }
  function onRowClick(){
    var tr = window.event ? window.event.srcElement : this;
    while (tr && tr.tagName && tr.tagName.toLowerCase() != "tr"){
      tr = tr.parentNode;
    }
    if (!tr) return;
    state.selectedRowId = tr._rowid;
    highlightSelection();
    renderDetails();
  }
  function onRowDblClick(){
    onRowClick();
    openPatientDetailWindow();
  }

  // Opens MedflowSettings.hta as a real independent top-level window
  // (non-modal — HTA/JScript has no P/Invoke to enforce genuine
  // EnableWindow-style modality, so this window and Main stay concurrently
  // operable, same as MedflowDetail.hta below).
  function openSettingsWindow(){
    var here = document.location.pathname.replace(/[^\\\/]*$/, "");
    var target = here + "MedflowSettings.hta";
    try{
      var shell = new ActiveXObject("WScript.Shell");
      shell.Run('mshta.exe "' + target + '"', 1, false);
    }catch(e){
      alert("Could not open Settings window: " + e.message);
    }
  }

  // Opens the currently-selected patient in a real independent top-level
  // window (MedflowDetail.hta), non-modal — can be operated concurrently
  // with this window. Distinct from openRecordModal(), which stays reachable
  // via the "View inline summary" link in the Details panel.
  function openPatientDetailWindow(){
    if (!state.selectedRowId) return;
    var row = findRowById(state.selectedRowId);
    if (!row || !row.patientId) return;
    var here = document.location.pathname.replace(/[^\\\/]*$/, "");
    var target = here + "MedflowDetail.hta?pid=" + row.patientId;
    try{
      var shell = new ActiveXObject("WScript.Shell");
      shell.Run('mshta.exe "' + target + '"', 1, false);
    }catch(e){
      alert("Could not open Patient Detail window: " + e.message);
    }
  }

  // Cached button references (IE6-safe)
  var __menuButtons = [];
  var __actionButtons = [];

  function cacheButtons(){
    __menuButtons = [];
    __actionButtons = [];
    var inputs = document.getElementsByTagName("input");
    var i;
    for (i=0;i<inputs.length;i++){
      var el = inputs[i];
      if (el && el.id){
        if (el.id.indexOf("nav_") == 0){
          __menuButtons[__menuButtons.length] = el;
        } else if (el.id.indexOf("btn_") == 0){
          __actionButtons[__actionButtons.length] = el;
        }
      }
    }
  }

  function menuOver(){
    var src = window.event ? window.event.srcElement : this;
    if (!src) return;
    if (src.className.indexOf("menuBtnActive") < 0){
      src.className = "menuBtn menuBtnHover";
    }
  }
  function menuOut(){
    var src = window.event ? window.event.srcElement : this;
    if (!src) return;
    if (src.className.indexOf("menuBtnActive") < 0){
      src.className = "menuBtn";
    }
  }

  function setPressedButton(action){
    var i;
    for (i=0;i<__actionButtons.length;i++){
      var b = __actionButtons[i];
      if (!b || !b.id) continue;
      if (action && b.id == ("btn_" + action)){
        b.className = "mfBtn mfBtnActive";
      } else {
        b.className = "mfBtn";
      }
    }
  }

  function setActiveMenu(menuKey){
    var i;
    for (i=0;i<__menuButtons.length;i++){
      var b = __menuButtons[i];
      if (!b || !b.id) continue;
      if (menuKey && b.id == ("nav_" + menuKey)){
        b.className = "menuBtn menuBtnActive";
      } else {
        b.className = "menuBtn";
      }
    }
  }

  function syncHeaderScroll(){
    // keep header aligned when the body is horizontally scrolled
    try{
      $("listHeaderWrap").scrollLeft = $("listBodyWrap").scrollLeft;
    }catch(e){}
  }

  function setView(viewId, fromAction, fromMenu){
    state.view = viewId;
    state.quickFilter = "";
    $("quickFilter").value = "";
    state.selectedRowId = "";
    state.sortKey = "";
    state.sortDir = "asc";

    // reset list scroll positions (important for horizontal scrolling views)
    try{
      $("listBodyWrap").scrollTop = 0;
      $("listBodyWrap").scrollLeft = 0;
      $("listHeaderWrap").scrollLeft = 0;
    }catch(e){}

    if (fromAction){
      // department implied by some actions
      if (viewId == "glaucoma_followup") state.department = "Glaucoma";
      if (viewId == "retina_single") state.department = "Retina";
      if (viewId == "pediatric_single") state.department = "Pediatrics";
      if (viewId == "contact_lens_exam") state.department = "Contact Lenses";
      if (viewId == "refractive_exam") state.department = "Refractive";
      if (viewId == "optical") state.department = "Optical";
      if (viewId == "workup") state.department = "Workup";
      $("deptSelect").value = state.department;

      setPressedButton(getActionFromView(viewId));
      setActiveMenu("");
    }
    if (fromMenu){
      setActiveMenu(getMenuFromView(viewId));
      setPressedButton("");
    }

    updateRxCounts();
    renderView();
  }

  function getActionFromView(viewId){
    var k;
    for (k in ACTION_TO_VIEW){
      if (ACTION_TO_VIEW[k] == viewId) return k;
    }
    return "";
  }
  function getMenuFromView(viewId){
    var k;
    for (k in NAV_TO_VIEW){
      if (NAV_TO_VIEW[k] == viewId) return k;
    }
    return "";
  }

  function onActionButton(){
    var el = window.event ? window.event.srcElement : this;
    if (!el) return;
    // click can originate from child nodes; climb to an element with an id
    while (el && !el.id && el.parentNode){
      el = el.parentNode;
    }
    if (!el || !el.id) return;

    // action buttons are id="btn_<action>"
    if (el.id.indexOf("btn_") != 0) return;
    var action = el.id.substring(4);
    var viewId = ACTION_TO_VIEW[action];
    if (!viewId) return;
    setView(viewId, true, false);
  }

  
  function onMenuButton(){
    var el = window.event ? window.event.srcElement : this;
    if (!el) return;
    while (el && !el.id && el.parentNode){
      el = el.parentNode;
    }
    if (!el || !el.id) return;

    // menu buttons are id="nav_<key>"
    if (el.id.indexOf("nav_") != 0) return;
    var key = el.id.substring(4);
    var viewId = NAV_TO_VIEW[key];
    if (!viewId) return;
    setView(viewId, false, true);
  }

  
  function onFacilityChange(){
    state.facility = $("facilitySelect").value;
    updateRxCounts();
    renderView();
    renderDetails();
  }
  function onDeptChange(){
    state.department = $("deptSelect").value;
    updateRxCounts();
    renderView();
    renderDetails();
  }

  function onQuickFilter(){
    state.quickFilter = $("quickFilter").value;
    renderView();
  }

  function resetClinicians(){
    $("doctorInput").value = "William H Bartlett MD";
    $("techInput").value = "CitrusBits";
  }

  function searchName(){
    var q = trim($("searchInput").value);
    if (!q){
      alert("Enter a patient name to search.");
      return;
    }
    // Build search results view on the fly (simple)
    var ql = toLower(q);
    var matches = [];
    var i;
    for (i=0;i<DATA.patients.length;i++){
      var p = DATA.patients[i];
      var nm = toLower(p.name);
      if (nm.indexOf(ql) >= 0){
        matches[matches.length] = p;
      }
    }
    // Define a temporary view
    VIEW_DEFS["search_results"] = {
      title: function(){ return "Search Results"; },
      sub: function(){ return String(matches.length) + " match(es) for \"" + q + "\""; },
      columns: [
        {key:"name", label:"Name", width:200, sortable:1},
        {key:"mrn", label:"MRN", width:90, sortable:1},
        {key:"dept", label:"Dept", width:120, sortable:1},
        {key:"facility", label:"Facility", width:80, sortable:1},
        {key:"next", label:"Next Appt", width:100, sortable:1}
      ],
      rows: function(){
        var out = [];
        var j;
        for (j=0;j<matches.length;j++){
          var p2 = matches[j];
          out[out.length] = {
            id: "SR-" + p2.id,
            patientId: p2.id,
            name: p2.name,
            mrn: p2.mrn,
            dept: p2.department,
            facility: p2.facility,
            next: formatDate(p2.nextAppt)
          };
        }
        return out;
      }
    };

    setView("search_results", false, true);
  }

  function exitApp(){
    if (confirm("Exit Medflow Clinical System?")){
      window.close();
    }
  }

  // Clock
  function tickClock(){
    var now = new Date();
    setText($("clockDate"), formatDate(now));
    setText($("clockTime"), formatTime(now));
  }

  // Layout sizing
  function layout(){
    var h = (document.documentElement && document.documentElement.clientHeight) ? document.documentElement.clientHeight : document.body.clientHeight;
    var w = (document.documentElement && document.documentElement.clientWidth) ? document.documentElement.clientWidth : document.body.clientWidth;

    // 2026-08-31: titlebar/menubar/content row are plain divs, not a
    // table.app anymore — this old IE=7 rendering mode's table-layout:fixed
    // never reliably sized an undefined-width column against a colspan
    // row's content (it measured natural content width instead of the
    // spec's remaining-space rule), which pushed rightCell off the right
    // edge of the window (live repro, screenshot-confirmed) no matter how
    // the CSS was tuned. leftCell/rightCell are now CSS position:absolute
    // (left:0/right:360px and right:0/width:360px — see .leftCell/.rightCell)
    // so their width is correct with no JS involved at all. contentRow
    // still needs an explicit pixel height from here (it's a plain block
    // div, and leftCell/rightCell's bottom:0 needs a sized, position:relative
    // ancestor to anchor to).
    // Measure all three chrome bars rather than assuming fixed pixel heights.
    // The footer in particular used to be hardcoded at 56px while its real
    // rendered height was larger, so the bottom row of buttons (SETTINGS,
    // EXIT) fell past the bottom edge of the window and got clipped.
    var titlebarH = $("titlebarEl").offsetHeight;
    var menubarH = $("menubarEl").offsetHeight;
    var footerH = $("footerEl").offsetHeight;
    var contentH = h - titlebarH - menubarH - footerH;
    if (contentH < 200) contentH = 200;

    $("contentRow").style.height = contentH + "px";

    // Left scroll area height
    // left header approx 126px (brand + selectors). Keep dynamic.
    var leftHeaderH = $("leftHeader").offsetHeight;
    var leftButtonsH = contentH - leftHeaderH - 10;
    if (leftButtonsH < 140) leftButtonsH = 140;
    $("leftButtonsWrap").style.height = leftButtonsH + "px";

    // Right: rx (approx 80) + clock (approx 90) + header (approx 70) + list + details
    var rxH = $("rxBox").offsetHeight;
    var clockH = $("clockBox").offsetHeight;
    var workHeaderH = $("workHeader").offsetHeight;

    // Details height fixed-ish
    var detailsH = 150;
    $("detailsBox").style.height = detailsH + "px";

    var listAvail = contentH - rxH - clockH - workHeaderH - detailsH - 20;
    if (listAvail < 120) listAvail = 120;

    $("listBodyWrap").style.height = listAvail + "px";

    // Header wrap height fixed
    $("listHeaderWrap").style.height = "26px";

    // Make header and body widths consistent
    // (body wrap may show horizontal scroll if table wider)

    // Force fixed widths on scroll containers. In old IE/HTA, DIVs inside table cells
    // can shrink-to-fit their table content, which makes the horizontal scrollbar non-functional.
    var rcW = $("rightCell").offsetWidth;
    if (!rcW || rcW < 1) rcW = 360;
    var innerW = rcW - 16; // account for 8px left/right margins on list boxes
    if (innerW < 200) innerW = 200;

    $("listHeaderWrap").style.width = innerW + "px";
    $("listBodyWrap").style.width = innerW + "px";
    $("detailsBox").style.width = innerW + "px";
  }

  function init(){
    initMedflowData();
    defineViews();

    // wire events
    wireButtons();

    // defaults
    $("facilitySelect").value = state.facility;
    $("deptSelect").value = state.department;
    $("doctorInput").value = "William H Bartlett MD";
    $("techInput").value = "CitrusBits";

    updateRxCounts();
    tickClock();
    window.setInterval(tickClock, 1000);

    // default view is glaucoma followup
    setView("glaucoma_followup", true, false);

    // initial layout
    layout();
    addEvent(window, "resize", layout);
  }

  function wireMenuHover(){
    var inputs = document.getElementsByTagName("input");
    var i;
    for (i=0;i<inputs.length;i++){
      var el = inputs[i];
      if (el.getAttribute && el.getAttribute("data-view")){
        addEvent(el, "mouseover", function(){
          var src = window.event ? window.event.srcElement : this;
          if (src.className.indexOf("menuBtnActive") < 0) src.className = "menuBtn menuBtnHover";
        });
        addEvent(el, "mouseout", function(){
          var src = window.event ? window.event.srcElement : this;
          if (src.className.indexOf("menuBtnActive") < 0) src.className = "menuBtn";
        });
      }
    }
  }

  function wireButtons(){
    // Cache the nav/action buttons once (avoids custom attributes in old IE)
    cacheButtons();

    var i;

    // Menu buttons (top nav)
    for (i=0;i<__menuButtons.length;i++){
      var m = __menuButtons[i];
      addEvent(m, "click", onMenuButton);
      addEvent(m, "mouseover", menuOver);
      addEvent(m, "mouseout", menuOut);
    }

    // Main action buttons (center panel)
    for (i=0;i<__actionButtons.length;i++){
      var a = __actionButtons[i];
      addEvent(a, "click", onActionButton);
    }

    addEvent($("facilitySelect"), "change", onFacilityChange);
    addEvent($("deptSelect"), "change", onDeptChange);
    addEvent($("quickFilter"), "keyup", onQuickFilter);
    addEvent($("listBodyWrap"), "scroll", syncHeaderScroll);

    addEvent($("resetCliniciansBtn"), "click", resetClinicians);
    addEvent($("searchBtn"), "click", searchName);
    addEvent($("exitBtn"), "click", exitApp);
    addEvent($("settingsBtn"), "click", openSettingsWindow);

    // Enter key in search input
    addEvent($("searchInput"), "keyup", function(){
      var e = window.event;
      if (e && e.keyCode == 13) searchName();
    });

    // modal close
    addEvent($("modalCloseBtn"), "click", closeModal);
    addEvent($("modalCloseTopBtn"), "click", closeModal);
    addEvent($("modalPrintBtn"), "click", function(){
      // Print modal body (basic)
      window.print();
    });

    // encounters window
    addEvent($("encCloseBtn"), "click", closeEncModal);
    addEvent($("encCloseTopBtn"), "click", closeEncModal);
    addEvent($("encAddPatientLink"), "click", onAddNewPatient);
    addEvent($("encAddEncounterLink"), "click", onAddEncounter);
    addEvent($("encViewPdfBtn"), "click", onViewPdf);
    addEvent($("encPrintSelectedBtn"), "click", onPrintSelected);

    // tab buttons
    var tabs = ["search","demos","insurances","preauth","contacts","summary","appointments","followup","documents","encounters","bills","notes","pharmacies","rx","intakeforms"];
    var ti;
    for (ti=0;ti<tabs.length;ti++){
      var tb = $("encTab_" + tabs[ti]);
      if (tb) addEvent(tb, "click", onEncTabClick);
    }
  }

  
  // Start when ready
  addEvent(window, "load", init);

  </script>
</head>

<body>
  <div id="titlebarEl" class="titlebar">
    Medflow Clinical System
    <span class="meta">Copyright 1999-2025 Medflow, Inc. &nbsp;&nbsp; Database: MEDFLOW</span>
  </div>

  <div id="menubarEl" class="menubar">
    <input type="button" class="menuBtn" id="nav_admin" value="Administration" />
    <input type="button" class="menuBtn" id="nav_front_desk" value="Front Desk" />
    <input type="button" class="menuBtn" id="nav_technician" value="Technician" />
    <input type="button" class="menuBtn" id="nav_doctor_function" value="Doctor Function" />
    <input type="button" class="menuBtn" id="nav_asc_surgery" value="ASC/Surgery" />
    <input type="button" class="menuBtn" id="nav_contact_lenses" value="Contact Lenses" />
    <input type="button" class="menuBtn" id="nav_billing" value="Billing" />
    <input type="button" class="menuBtn" id="nav_file_maint" value="File Maint" />
    <input type="button" class="menuBtn" id="nav_image_processing" value="Image Processing" />
    <input type="button" class="menuBtn" id="nav_procedures" value="Procedures" />
    <input type="button" class="menuBtn" id="nav_query_tool" value="Query Tool" />
    <input type="button" class="menuBtn" id="nav_practice_mgmt" value="Practice Management" />
    <input type="button" class="menuBtn" id="nav_quick_message" value="Quick Message" />
  </div>

  <div id="contentRow" class="contentRowWrap">
      <div id="leftCell" class="leftCell">
        <div id="leftHeader" class="leftHeader">
          <div class="brandBox">
            <div class="brandName">Medflow</div>
            <div class="brandSub">by Sightview</div>
          </div>

          <div class="selectorsBox">
            <div>
              <label>Facility:</label>
              <select id="facilitySelect">
                <option value="TC1">TC1</option>
                <option value="TC2">TC2</option>
                <option value="East">East</option>
              </select>
            </div>
            <div>
              <label>Department:</label>
              <select id="deptSelect">
                <option value="Glaucoma">Glaucoma</option>
                <option value="Retina">Retina</option>
                <option value="Pediatrics">Pediatrics</option>
                <option value="Optical">Optical</option>
                <option value="Contact Lenses">Contact Lenses</option>
                <option value="Refractive">Refractive</option>
                <option value="Workup">Workup</option>
              </select>
            </div>
          </div>
        </div>

        <div id="leftButtonsWrap" class="leftButtonsWrap">
          <table class="btnGrid">
            <tr>
              <td><input type="button" class="mfBtn" id="btn_single_screen" value="DIRECT TO SINGLE SCREEN EXAM" /></td>
              <td><input type="button" class="mfBtn" id="btn_specialized_exams" value="SPECIALIZED EXAMS" /></td>
            </tr>
            <tr>
              <td><input type="button" class="mfBtn" id="btn_refractive_exam" value="REFRACTIVE EXAM" /></td>
              <td><input type="button" class="mfBtn" id="btn_glaucoma_followup" value="DIRECT TO GLAUCOMA FOLLOW UP" /></td>
            </tr>
            <tr>
              <td><input type="button" class="mfBtn" id="btn_workup" value="WORKUP" /></td>
              <td><input type="button" class="mfBtn" id="btn_contact_lens_exam" value="CONTACT LENS EXAM" /></td>
            </tr>
            <tr>
              <td><input type="button" class="mfBtn" id="btn_optical" value="OPTICAL" /></td>
              <td><input type="button" class="mfBtn" id="btn_workflow_maint" value="WORKFLOW FILE MAINTENANCE" /></td>
            </tr>
            <tr>
              <td><input type="button" class="mfBtn" id="btn_retina_single" value="DIRECT TO RETINA SINGLE SCREEN" /></td>
              <td><input type="button" class="mfBtn" id="btn_patient_data" value="PATIENT DATA" /></td>
            </tr>
            <tr>
              <td colspan="2"><input type="button" class="mfBtn" id="btn_pediatric_single" style="width:100%;" value="DIRECT PEDIATRIC SINGLE SCREEN" /></td>
            </tr>
          </table>
        </div>
      </div>

      <div id="rightCell" class="rightCell">
        <div id="rxBox" class="rxBox">
          <div class="rxRowItem"><span class="rxLabel">DrFirst Pending RX Count:</span><span class="rxNum" id="rxPending">0</span></div>
          <div class="rxRowItem"><span class="rxLabel">Refill Request Count:</span><span class="rxNum" id="rxRefill">0</span></div>
          <div class="rxRowItem"><span class="rxLabel">RxChange Count:</span><span class="rxNum" id="rxChange">0</span></div>
          <div class="rxRowItem"><span class="rxLabel">RxNeedSigning Count:</span><span class="rxNum" id="rxNeedSigning">0</span></div>
        </div>

        <div id="clockBox" class="clockBox">
          <div class="clockDate" id="clockDate">--/--/----</div>
          <div class="clockTime" id="clockTime">--:--:-- --</div>
        </div>

        <div id="workHeader" class="workHeader">
          <div class="workTitle" id="viewTitle">Queue</div>
          <div class="workSub" id="viewSub">Select a row to view details.</div>

          <div class="filterRow">
            <span style="color:#555;">Filter:</span>
            <input type="text" id="quickFilter" />
          </div>
        </div>

        <div id="listHeaderWrap" class="listHeaderWrap">
          <table id="listHeaderTable" class="listTable"></table>
        </div>
        <div id="listBodyWrap" class="listBodyWrap">
          <table id="listBodyTable" class="listTable"></table>
        </div>

        <div id="detailsBox" class="detailsBox">
          <div class="detailsHdr">
            Details
            <span class="pill" id="selectionPill">No selection</span>
            <div style="clear:both;"></div>
          </div>
          <div id="detailsBody" style="color:#555;">Select a row in the list to view details.</div>
        </div>
      </div>
  </div>

  <div id="footerEl" class="footer">
    <table class="footerTable">
      <tr>
        <td><b>Doctor:</b></td>
        <td><input type="text" id="doctorInput" class="footerInput" value="William H Bartlett MD" /></td>
        <td><input type="button" id="resetCliniciansBtn" class="footerBtn" value="RESET CLINICIANS" /></td>
        <td style="width:18px;"></td>
        <td><b>Technician:</b></td>
        <td><input type="text" id="techInput" class="footerInput" value="CitrusBits" /></td>
        <td style="width:18px;"></td>
        <td><input type="text" id="searchInput" class="footerInput" style="width:220px;" value="" /></td>
        <td><input type="button" id="searchBtn" class="footerBtn" value="SEARCH NAME" /></td>
        <td style="width:12px;"></td>
        <td><input type="button" id="settingsBtn" class="footerBtn" value="SETTINGS" /></td>
        <td><input type="button" id="exitBtn" class="footerBtn" value="EXIT" /></td>
      </tr>
    </table>
  </div>

  <!-- Modal -->
  <div id="overlay" class="overlay"></div>
  <div id="modal" class="modal">
    <div class="modalHead">
      <span id="modalTitle">Patient Record</span>
      <input type="button" id="modalCloseTopBtn" class="modalBtn" style="float:right;" value="CLOSE" />
      <div style="clear:both;"></div>
    </div>
    <div id="modalBody" class="modalBody"></div>
    <div class="modalFoot">
      <input type="button" id="modalPrintBtn" class="modalBtn" value="PRINT" />
      <input type="button" id="modalCloseBtn" class="modalBtn" value="CLOSE" />
    </div>
  </div>


  <!-- Encounters Window -->
  <div id="encOverlay" class="overlay"></div>
  <div id="encModal" class="encModal">
    <div class="encHead">
      <span id="encTitle">Patient's Registration Details</span>
      <input type="button" id="encCloseTopBtn" class="modalBtn" style="float:right;width:28px;" value="X" />
      <div style="clear:both;"></div>
    </div>

    <div class="encTabs">
      <input type="button" class="tabBtn" id="encTab_search" value="Search" />
      <input type="button" class="tabBtn" id="encTab_demos" value="Demos" />
      <input type="button" class="tabBtn" id="encTab_insurances" value="Insurances" />
      <input type="button" class="tabBtn" id="encTab_preauth" value="Pre Auth" />
      <input type="button" class="tabBtn" id="encTab_contacts" value="Contacts" />
      <input type="button" class="tabBtn" id="encTab_summary" value="Summary" />
      <input type="button" class="tabBtn" id="encTab_appointments" value="Appointments" />
      <input type="button" class="tabBtn" id="encTab_followup" value="Followup" />
      <input type="button" class="tabBtn" id="encTab_documents" value="Documents" />
      <input type="button" class="tabBtn tabBtnActive" id="encTab_encounters" value="Encounters" />
      <input type="button" class="tabBtn" id="encTab_bills" value="Bills" />
      <input type="button" class="tabBtn" id="encTab_notes" value="Notes" />
      <input type="button" class="tabBtn" id="encTab_pharmacies" value="Pharmacies" />
      <input type="button" class="tabBtn" id="encTab_rx" value="Rx" />
      <input type="button" class="tabBtn" id="encTab_intakeforms" value="IntakeForms" />
    </div>

    <div class="encBody">
      <div id="encPane_search" class="encPane">
        <div class="encSectionTitle">Search</div>
        <div style="font-size:12px;color:#666;">Search tools are available in the full system.</div>
      </div>

      <div id="encPane_demos" class="encPane">
        <div class="encSectionTitle">Demos</div>
        <div style="font-size:12px;color:#666;">Demographics details are available in the full system.</div>
      </div>

      <div id="encPane_insurances" class="encPane">
        <div class="encSectionTitle">Insurances</div>
        <div style="font-size:12px;color:#666;">Insurance information is available in the full system.</div>
      </div>

      <div id="encPane_preauth" class="encPane">
        <div class="encSectionTitle">Pre Auth</div>
        <div style="font-size:12px;color:#666;">Pre-authorization workflows are available in the full system.</div>
      </div>

      <div id="encPane_contacts" class="encPane">
        <div class="encSectionTitle">Contacts</div>
        <div style="font-size:12px;color:#666;">Contacts are available in the full system.</div>
      </div>

      <div id="encPane_summary" class="encPane">
        <div class="encSectionTitle">Summary</div>
        <div style="font-size:12px;color:#666;">Summary view is available in the full system.</div>
      </div>

      <div id="encPane_appointments" class="encPane">
        <div class="encSectionTitle">Appointments</div>
        <div style="font-size:12px;color:#666;">Appointments are available in the full system.</div>
      </div>

      <div id="encPane_followup" class="encPane">
        <div class="encSectionTitle">Followup</div>
        <div style="font-size:12px;color:#666;">Follow-up workflows are available in the full system.</div>
      </div>

      <div id="encPane_documents" class="encPane">
        <div class="encSectionTitle">Documents</div>
        <div style="font-size:12px;color:#666;">Documents are available in the full system.</div>
      </div>

      <div id="encPane_bills" class="encPane">
        <div class="encSectionTitle">Bills</div>
        <div style="font-size:12px;color:#666;">Billing information is available in the full system.</div>
      </div>

      <div id="encPane_notes" class="encPane">
        <div class="encSectionTitle">Notes</div>
        <div style="font-size:12px;color:#666;">Notes are available in the full system.</div>
      </div>

      <div id="encPane_pharmacies" class="encPane">
        <div class="encSectionTitle">Pharmacies</div>
        <div style="font-size:12px;color:#666;">Pharmacy information is available in the full system.</div>
      </div>

      <div id="encPane_rx" class="encPane">
        <div class="encSectionTitle">Rx</div>
        <div style="font-size:12px;color:#666;">Prescription workflows are available in the full system.</div>
      </div>

      <div id="encPane_intakeforms" class="encPane">
        <div class="encSectionTitle">IntakeForms</div>
        <div style="font-size:12px;color:#666;">Intake forms are available in the full system.</div>
      </div>

      <div id="encPane_encounters" class="encPane encPaneActive">
        <div style="margin-bottom:6px;">
          <span id="encAddPatientLink" class="encTopLink">Add New Patient</span>
        </div>

        <div class="encSectionTitle">Patient Encounters</div>

        <div class="encAddRow">
          <span class="encPlus">+</span>
          <span id="encAddEncounterLink" class="encAddLink">Click Here To Add Encounters</span>
        </div>

        <div class="encTableWrap">
          <table class="encTable" cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:100px;" />
              <col style="width:160px;" />
              <col style="width:130px;" />
              <col style="width:90px;" />
              <col style="width:140px;" />
              <col style="width:50px;" />
              <col style="width:140px;" />
              <col style="width:110px;" />
            </colgroup>
            <thead>
              <tr>
                <th>Encounter Id</th>
                <th>Provider Name</th>
                <th>Facility Name</th>
                <th>Date</th>
                <th>Description</th>
                <th>Edit</th>
                <th>&nbsp;</th>
                <th>Select To Print</th>
              </tr>
            </thead>
            <tbody id="encTableBody"></tbody>
          </table>
        </div>

        <div class="encButtonRow">
          <input type="button" class="encButton" id="encViewPdfBtn" value="View PDF" />
          <input type="button" class="encButton" id="encPrintSelectedBtn" value="Print Selected" />
        </div>

        <div class="encCloseRow">
          <input type="button" class="encCloseBtn" id="encCloseBtn" value="CLOSE" />
        </div>
      </div>
    </div>
  </div>

</body>
</html>
