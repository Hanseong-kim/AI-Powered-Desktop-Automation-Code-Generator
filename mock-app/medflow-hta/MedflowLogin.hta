<html>
<head>
  <title>Medflow Login</title>

  <HTA:APPLICATION
      ID="MedflowLoginApp"
      APPLICATIONNAME="Medflow Login"
      BORDER="thin"
      BORDERSTYLE="normal"
      CAPTION="yes"
      CONTEXTMENU="yes"
      MAXIMIZEBUTTON="no"
      MINIMIZEBUTTON="yes"
      SHOWINTASKBAR="yes"
      SINGLEINSTANCE="no"
      SYSMENU="yes"
      WINDOWSTATE="normal"
      SCROLL="no"
  />

  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=7" />

  <style type="text/css">
    html, body { height: 100%; }
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #bfbfbf;
      font-family: Tahoma, Arial, sans-serif;
      font-size: 12px;
      color: #111;
    }
    .wrap {
      width: 420px;
      margin: 60px auto 0 auto;
      border: 1px solid #9a9a9a;
      background: #d9d9ff;
      padding: 18px 24px 22px 24px;
    }
    .brandName {
      font-size: 30px;
      font-weight: bold;
      line-height: 32px;
    }
    .brandSub {
      color: #555;
      font-size: 12px;
      margin: 2px 0 18px 0;
    }
    .fieldRow {
      margin-bottom: 12px;
    }
    .fieldRow label {
      display: block;
      font-weight: bold;
      margin-bottom: 3px;
    }
    .fieldRow input[type="text"],
    .fieldRow input[type="password"] {
      font-family: Tahoma, Arial, sans-serif;
      font-size: 13px;
      border: 1px solid #9a9a9a;
      padding: 5px 6px;
      width: 100%;
    }
    .btnRow {
      margin-top: 18px;
      text-align: right;
    }
    .loginBtnStyle, .cancelBtnStyle {
      font-family: Tahoma, Arial, sans-serif;
      font-size: 12px;
      font-weight: bold;
      background: #ececec;
      border: 2px solid #9a9a9a;
      border-top-color: #ffffff;
      border-left-color: #ffffff;
      padding: 7px 16px;
      cursor: pointer;
      margin-left: 8px;
    }
    .hint {
      margin-top: 14px;
      font-size: 11px;
      color: #555;
    }
  </style>

  <script language="JScript">
    function $(id){ return document.getElementById(id); }

    function addEvent(el, evt, fn){
      if (!el) return;
      if (el.attachEvent) el.attachEvent('on' + evt, fn);
      else if (el.addEventListener) el.addEventListener(evt, fn, false);
      else el['on' + evt] = fn;
    }

    // Path of this .hta's own directory, used to locate MedflowMain.hta
    // regardless of where this fixture is checked out / cloned.
    function thisDir(){
      return document.location.pathname.replace(/[^\\\/]*$/, "");
    }

    function doLogin(){
      var user = $("userInput").value;
      var pass = $("passInput").value;

      // Hardcoded credential check (this is a recording/replay fixture, not
      // a real login) — matches the credential pair from the original
      // WinForms mock-app spec (docs/superpowers/specs/2026-08-26-mock-test-app-design.md)
      // for consistency.
      if (user !== "admin" || pass !== "1234"){
        alert("Invalid user ID or password.");
        return;
      }

      var target = thisDir() + "MedflowMain.hta";
      try{
        var shell = new ActiveXObject("WScript.Shell");
        shell.Run('mshta.exe "' + target + '"', 1, false);
      }catch(e){
        alert("Could not launch Medflow: " + e.message);
        return;
      }
      window.close();
    }

    function doCancel(){
      window.close();
    }

    function onPassKeyUp(){
      var e = window.event;
      if (e && e.keyCode == 13) doLogin();
    }

    function init(){
      addEvent($("loginBtn"), "click", doLogin);
      addEvent($("cancelBtn"), "click", doCancel);
      addEvent($("passInput"), "keyup", onPassKeyUp);
      $("userInput").focus();
    }
    addEvent(window, "load", init);
  </script>
</head>

<body>
  <div class="wrap">
    <div class="brandName">Medflow</div>
    <div class="brandSub">by Sightview — Clinical System Login</div>

    <div class="fieldRow">
      <label for="userInput">User ID</label>
      <input type="text" id="userInput" value="" autocomplete="off" />
    </div>
    <div class="fieldRow">
      <label for="passInput">Password</label>
      <input type="password" id="passInput" value="" autocomplete="off" />
    </div>

    <div class="btnRow">
      <input type="button" id="cancelBtn" class="cancelBtnStyle" value="CANCEL" />
      <input type="button" id="loginBtn" class="loginBtnStyle" value="LOGIN" />
    </div>

    <div class="hint">Demo credentials: admin / 1234</div>
  </div>
</body>
</html>
